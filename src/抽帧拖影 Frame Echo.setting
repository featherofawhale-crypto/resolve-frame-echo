Inputs = {
Input = Input { SourceOp = "FE_TransformBypass", Source = "Output", },
SourceTime = Input { Expression = "math.min(comp.RenderEnd,math.max(comp.RenderStart,time))", },
InterpolateBetweenFrames = Input { Value = 0, },
},
ViewInfo = OperatorInfo { Pos = { 110, 0 } },

},
FE_TransformBypass = Dissolve {
Inputs = {
Background = Input { SourceOp = "FE_Input", Source = "Output", },
Foreground = Input { SourceOp = "FE_Transform", Source = "Output", },
Mix = Input { Expression = "iif(FE_Hold.TransformEnabled>0.5,1,0)", },
},
ViewInfo = OperatorInfo { Pos = { 160, -80 } },

},
FE_Hold = TimeStretcher {
Inputs = {
Input = Input { SourceOp = "FE_Bounds", Source = "Output", },
SourceTime = Input { Expression = ":local a=math.ceil(comp.RenderStart); local t=math.max(a,math.floor(time+0.000001)); if self.HoldEnabled<0.5 then return math.min(comp.RenderEnd,t) end; local r=math.max(0.001,comp:GetPrefs(\"Comp.FrameFormat.Rate\")); local mode=self.RateMode; local dep=self.TargetFPS+self.FrameStep; local phase=0; local held=a; for f=a,t-1 do local rate; if mode<0.5 then rate=math.min(1,math.max(0.1,self:GetValue(\"TargetFPS\",f))/r); else rate=1/math.max(1,math.floor(self:GetValue(\"FrameStep\",f)+0.5)); end; local before=math.floor(phase+0.0000001); phase=phase+rate; if math.floor(phase+0.0000001)>before then held=f+1 end; end; return math.min(comp.RenderEnd,held)", },
InterpolateBetweenFrames = Input { Value = 0, },
RateMode = Input { Expression = "FrameEcho.Input1", },
TargetFPS = Input { Expression = "FrameEcho.Input2", },
FrameStep = Input { Expression = "FrameEcho.Input3", },
TrailMode = Input { Expression = "FrameEcho.Input4", },
Strength = Input { Expression = "FrameEcho.Input5", },
TrailLength = Input { Expression = "FrameEcho.Input6", },
LayerChoice = Input { Expression = "FrameEcho.Input7", },
ShutterLength = Input { Expression = "FrameEcho.Input8", },
MotionMode = Input { Expression = "FrameEcho.Input9", },
MotionLength = Input { Expression = "FrameEcho.Input10", },
MotionAngle = Input { Expression = "FrameEcho.Input11", },
ClearRadius = Input { Expression = "FrameEcho.Input12", },
ClearFeather = Input { Expression = "FrameEcho.Input13", },
HoldEnabled = Input { Expression = "FrameEcho.Input15", },
TrailEnabled = Input { Expression = "FrameEcho.Input16", },
ClearEnabled = Input { Expression = "FrameEcho.Input17", },
MotionEnabled = Input { Expression = "FrameEcho.Input18", },
ClearShape = Input { Expression = "FrameEcho.Input19", },
TransformEnabled = Input { Expression = "FrameEcho.Input21", },
},
